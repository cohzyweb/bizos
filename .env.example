# Copy this file to .env and fill in your Supabase project values
# (Supabase dashboard > Project Settings > API).
#
# Project URL is https://<project-ref>.supabase.co — no /rest/v1/ suffix,
# and no spaces around the "=". Both values are required: without them the
# app shows the "Connect Supabase to start" screen instead of running.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Email verification redirects require Supabase URL Configuration
# (Supabase dashboard > Authentication > URL Configuration):
#   Site URL: https://bizos-dun.vercel.app
#   Redirect URLs:
#     - https://bizos-dun.vercel.app/*
#     - http://localhost:5173/*
# Without these, verification links fall back to Site URL and may hit
# Vercel's login (if Deployment Protection is enabled).
